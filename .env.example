# Copy this to .env and fill in values — never commit .env

# Shared
# --- Two-machine deployment (deploy/abhinav, deploy/ajay) ---
# Only needed when the components are split across hosts. Abhinav's compose
# file REFUSES to start without AJAY_IP rather than defaulting to a container
# name that does not resolve across machines.
ABHINAV_IP=
AJAY_IP=
SECRET_KEY=change-me
PASSWORD_PEPPER=change-me-in-production
# WebAuthn Relying Party. The IDP and the client MUST agree on this, and
# changing it invalidates every enrolled credential, which then re-enrols.
#
# It must be a REGISTRABLE domain. No DNS lookup is made — the IDP is reached
# at IDP_BASE_URL, and this is only the label credentials are bound to — but
# Windows will not release a TPM attestation to a relying party whose name is
# not registrable. A ".local" name (this project's original default) yields a
# working credential with NO attestation, which the IDP then refuses, and
# nothing in the failure names the cause. "localhost" also works, as the
# documented development exception.
RP_ID=ztna.example.com
RP_NAME=ZTNA-SDP Identity Provider
CA_CERT_PATH=./shared/ca/certs/root.crt
CA_KEY_PATH=./shared/ca/certs/root.key

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_SPA_PORT=62201
RESOURCE_NETWORK=data-plane-net
# The IDP's Gateway-only mTLS listener. The host must be one the IDP
# certificate was issued for (admin_cli.py issue-idp-cert --host ...).
GATEWAY_IDP_LINK_URL=https://localhost:9443
# This Gateway's bundle from `admin_cli.py issue-gateway-cert --id <id>`,
# relative to SDP_GATEWAY/.
GATEWAY_TLS_CERT_PATH=./certs/pki/gateway.crt
GATEWAY_TLS_KEY_PATH=./certs/pki/gateway.key
GATEWAY_CA_CERT_PATH=./certs/pki/ca.crt
# The Controller that decides. The Gateway asks it about every knock and does
# what the answer says. The host must be one the Controller certificate was
# issued for (admin_cli.py issue-controller-cert); on the compose network that
# is sdp-controller. The Gateway presents the same gateway.crt it uses above —
# one identity per Gateway, not two.
#
# Unreachable means DENIED. There is no local policy engine left in the Gateway
# to fall back to, because falling back means admitting without a decision.
GATEWAY_CONTROLLER_URL=https://localhost:9500
# Consecutive /session_review failures tolerated before the Gateway revokes
# every live session. 0 would cut every session on a single blip; no limit at
# all would let a Controller that stays down leave the Gateway enforcing
# decisions nobody is re-affirming any more.
GATEWAY_REVIEW_FAILURES_BEFORE_REVOKE=3

# --- SDP Controller (SDP_CONTROLLER/) — the Policy Decision Point ---
# Its own service, reached only by a Gateway over mutual TLS. No port is
# published to the host and it is not on the client or data-plane networks:
# nothing a client can reach decides whether that client gets in.
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=9500
# The Controller's bundle from `admin_cli.py issue-controller-cert`, relative
# to SDP_CONTROLLER/. ca.crt is what it checks every Gateway certificate
# against, and is the whole of its authorisation model.
CONTROLLER_TLS_CERT_PATH=./certs/pki/controller.crt
CONTROLLER_TLS_KEY_PATH=./certs/pki/controller.key
CONTROLLER_CA_CERT_PATH=./certs/pki/ca.crt
# /healthz is behind the same mutual TLS as the decision routes, so the
# container's own probe needs a client certificate. controller.crt cannot be
# used for it (a TLS server refuses a server certificate offered as a client
# one) and a Gateway's key has no business on this host, so
# issue-controller-cert mints this pair for the probe alone.
CONTROLLER_HEALTH_CERT_PATH=./certs/pki/health.crt
CONTROLLER_HEALTH_KEY_PATH=./certs/pki/health.key
# The decision inputs. Mounted into the container, so editing policy does not
# mean rebuilding an image.
CONTROLLER_POLICIES_PATH=./policies.yaml
CONTROLLER_TELEMETRY_PATH=./telemetry_snapshot.json
# How long an APPROVED session lives before it must be re-affirmed. It bounds
# how long a device whose posture has collapsed keeps its firewall hole.
CONTROLLER_TTL_SECONDS=30

# Client
CLIENT_CERT_PATH=./SDP_CLIENT/certs/
TPM_DEVICE_PATH=/dev/tpm0
SPA_KEY=change-me-spa-key
# Non-interactive first-factor credentials (optional). Useful where the
# terminal gives Python no console stdin; CLI flags override these.
CLIENT_USERNAME=
CLIENT_PASSWORD=
# The resource port the SPA knock asks the Gateway to open.
CLIENT_ACCESS_PORT=443
CLIENT_ACCESS_PROTOCOL=tcp
# Trust anchor. Leave TPM_TCTI empty for automatic platform detection:
# Windows uses CNG's Platform Crypto Provider, Linux uses tpm2-tools against
# the default device, and WSL additionally tries the software TPM below.
# Set TPM_TCTI to force a specific tpm2-tools target on any platform.
TPM_TCTI=
TPM_SWTPM_TCTI=swtpm:host=127.0.0.1,port=2321

# Resource Node
RESOURCE_PORT=7443
GATEWAY_CERT_FINGERPRINT=

# --- Standalone IDP (IDENTITY_PROVIDER/) ---
IDP_HOST=0.0.0.0
IDP_PORT=9000
IDP_BASE_URL=http://localhost:9000
IDP_DB_PATH=./data/idp.db
IDP_JWT_PRIVATE_KEY_PATH=./certs/idp_jwt_private.pem
IDP_JWT_PUBLIC_KEY_PATH=./certs/idp_jwt_public.pem
IDP_ACCESS_TTL_SECONDS=900
IDP_REFRESH_TTL_SECONDS=43200
IDP_LOGIN_TOKEN_TTL_SECONDS=120
IDP_ADMIN_API_KEY=
IDP_TOKEN_AUDIENCE=sdp-gateway
# The access token names both; the resource nodes accept it too.
IDP_RESOURCE_AUDIENCE=resource-node
# Knock ticket: 133-byte ES256-signed token carried in the SPA knock.
IDP_KNOCK_TICKET_TTL_SECONDS=60
IDP_TICKET_PRIVATE_KEY_PATH=./certs/idp_ticket_private.pem
IDP_TICKET_PUBLIC_KEY_PATH=./certs/idp_ticket_public.pem
IDP_ISSUER=https://idp.ztna.example.com
# IDP <-> Gateway mutual TLS: a second listener that only Gateways use, to
# register their ML-KEM public key and fetch the JWKS. The CA and the IDP
# certificate come from `admin_cli.py init-ca` / `issue-idp-cert`.
IDP_GATEWAY_LINK_HOST=0.0.0.0
IDP_GATEWAY_LINK_PORT=9443
IDP_CA_DIR=./certs/ca
IDP_TLS_CERT_PATH=./certs/pki/idp.crt
IDP_TLS_KEY_PATH=./certs/pki/idp.key

# Hardware attestation. With this on, the IDP only enrols a credential whose
# authenticator proved the private key was generated inside it and cannot be
# exported. Set it to false only for a backend that cannot yet produce an
# attestation statement — today that is the Windows CNG trust anchor.
IDP_ENFORCE_TPM_ATTESTATION=true
# Directory of PEM-encoded TPM vendor / platform attestation-CA roots. Drop
# your chip vendor's roots here and a TPM attestation must chain to one of
# them, which is what proves the chip is genuine silicon. Left empty (the
# default, and the only option under a WSL software TPM) the IDP instead pins
# each device's attestation key on its first enrolment.
IDP_TPM_ROOT_CA_DIR=./certs/tpm_roots
